# Copy to config/.env for local builds (config/.env is gitignored).
# In GitHub Actions, set the same names as repository variables
# (Settings → Secrets and variables → Actions → Variables).

# International format, digits only.
WHATSAPP_NUMBER=595981344033
# Optional. Derived from WHATSAPP_NUMBER when empty.
WHATSAPP_DISPLAY=+595 981 344 033
# Optional. The pages show "[CORREO]" until it is set.
CONTACT_EMAIL=contacto@lognlabs.com.py
# Optional. Tag Manager container (GTM-XXXXXXX) or GA4 ID (G-XXXXXXXXXX); analytics stays off when empty.
# Events only reach GA4 on lognlabs.com.py (or with ?ga_debug=1 on any host).
GOOGLE_TAG_ID=
